# ============================================
# CropShield AI – Environment Configuration
# ============================================

# Optional custom backend URL (leave empty to use in-memory mock services)
VITE_API_BASE_URL=
VITE_API_TIMEOUT=15000

# ============================================
# GNANI AI (Vachana) BACKEND CONFIGURATION
# ============================================
# NOTE: Store this ONLY in backend environment.
# Never prefix with VITE_ to prevent leaking into browser JavaScript.
# Get your API Key ID from: https://api.vachana.ai (Dashboard)
GNANI_API_KEY_ID=
GNANI_API_BASE_URL=https://api.vachana.ai
